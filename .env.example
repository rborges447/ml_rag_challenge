# Para Docker Compose: no serviço ui use API_BASE_URL=http://api:8000 (override no compose).
# Para uso local: API_BASE_URL=http://localhost:8000

# Backend (API) – paths e LLM
CHROMA_PATH=data/chroma
UPLOAD_DIR=data/raw

# Nível de log da API: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

############################################
# LLM configuration
############################################

# Timeout máximo para resposta do modelo (segundos)
LLM_TIMEOUT_SECONDS=60

# Cadeia de fallback entre modelos e providers
# Formato: provider:model
# Ordem = prioridade
# Exemplo abaixo:
# 1. tenta Gemini 3 Flash
# 2. se falhar tenta Gemini 2.5 Flash
# 3. se falhar tenta OpenAI
LLM_ROUTE=gemini:gemini-3-flash-preview,gemini:gemini-2.5-flash,openai:gpt-4.1-mini

############################################
# Gemini
############################################

# Chave da API Gemini
GEMINI_API_KEY=

############################################
# OpenAI
############################################

# Chave da API OpenAI
OPENAI_API_KEY=

############################################
# UI (Streamlit)
############################################

# Para Docker Compose:
# API_BASE_URL=http://api:8000
#
# Para uso local:
# API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Timeout das chamadas HTTP da UI para a API
UI_HTTP_TIMEOUT_SECONDS=60